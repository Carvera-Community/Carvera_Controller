
<ToolTipButton>:
    show_tooltips: app.show_tooltips
    tooltip_delay: app.tooltip_delay
    background_color: 0,0,0,0

<ToolTipDropDown>:
    show_tooltips: app.show_tooltips
    tooltip_delay: app.tooltip_delay

<ToolTipTextInput>:
    show_tooltips: app.show_tooltips
    tooltip_delay: app.tooltip_delay
    on_focus: self.on_input_focus(self, self.focus)

<ToolTipSwitch>:
    show_tooltips: app.show_tooltips
    tooltip_delay: app.tooltip_delay

<Tooltip>:
    size_hint: None, None
    width: (tooltip_label.texture_size[0] + tooltip_image.width + self.spacing + 20) if self.orientation == 'horizontal' and tooltip_image.width else max(tooltip_label.texture_size[0] + 20, tooltip_image.width + 20, 220 if tooltip_label.text else 0)
    height: (max(tooltip_label.texture_size[1], tooltip_image.height) + 20) if self.orientation == 'horizontal' and tooltip_image.width else tooltip_label.texture_size[1] + tooltip_image.height + 20
    # Size is applied in Python. Binding it to minimum_size reintroduces a blank
    # top gap when tooltip text changes: the unused image child still adds spacing.
    orientation: 'vertical'
    padding: 10, 10
    spacing: 15
    canvas.before:
        Color:
            rgba: app.theme.tooltip_bg
        Rectangle:
            size: self.size[0]+10,self.size[1]
            pos: self.pos
        Color:
            rgba: app.theme.tooltip_border
        Line:
            width: app.theme.tooltip_border_width
            rectangle: (self.pos[0],self.pos[1], self.size[0] + 10 ,self.size [1]) 

    BoxLayout:
        size_hint: None, None
        size: tooltip_image.size
        pos_hint: {"center_y": 0.5} if root.orientation == 'horizontal' else {"center_x": 0.5}
        Image:
            id: tooltip_image
            size_hint: None, None
            fit_mode: 'scale-down'
            size: self.texture_size

    ToolTipContentLabel:
        id: tooltip_label
        size_hint: None, None
        size: self.texture_size
        halign: 'left'
        valign: 'middle'
        pos_hint: {"center_y": 0.5} if root.orientation == 'horizontal' else {}

<ToolTipContentLabel>:
    id: tooltip_label
    size_hint: None, None
    height: self.texture_size[1]
    halign: 'left'
    valign: 'top'
    show_tooltips: app.show_tooltips
    tooltip_delay: app.tooltip_delay

    canvas.before:
        Color:
            rgba: 0, 0, 0, 0
        Rectangle:
            size: self.size
            pos: self.pos

<HelpButton>
    id: help_button
    size_hint: 1, 1
    canvas.before:
        Color:
            rgba: app.theme.button_fill('help', self.state, self.disabled, True, app.theme.revision)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(app.theme.radius_m),]
    Image:
        id: image
        source: root.image_source
        fit_mode: 'contain'
        size_hint: None, None
        size: min(dp(28), root.width * 0.7, root.height * 0.7), min(dp(28), root.width * 0.7, root.height * 0.7)
        pos_hint: {'center_x': 0.5, 'center_y': 0.5}
