#:import tr carveracontroller.__main__.tr

<LocalFilePickerDirButton>:
    orientation: 'horizontal'
    spacing: dp(4)
    padding: dp(4), dp(6)
    canvas.before:
        Color:
            rgba: app.theme.row_selected
        Rectangle:
            pos: self.pos
            size: self.size
    Label:
        size_hint_x: None
        width: dp(16)
        canvas.before:
            Color:
                rgba: app.theme.icon
            Rectangle:
                source: 'data/connected.png'
                pos: self.center_x - dp(8), self.center_y - dp(8)
                size: dp(16), dp(16)
    Image:
        size_hint_x: None
        width: dp(18)
        height: dp(18)
        allow_stretch: True
        keep_ratio: True
        source: 'data/folder-32.png'
        color: app.theme.icon
    Label:
        text: root.data_text
        shorten: True
        shorten_from: 'right'
        halign: 'left'
        valign: 'middle'
        text_size: self.width, None
        color: app.theme.text

<LocalFilePickerSheet>:
    orientation: 'vertical'
    padding: dp(8)
    spacing: dp(8)
    Label:
        text: tr._('Choose folder and file name') if root.show_filename else tr._('Choose a folder')
        size_hint_y: None
        height: dp(28)
        font_size: dp(15)
        text_size: self.width, None
        halign: 'left'
        color: app.theme.text_secondary
    BoxLayout:
        size_hint_y: None
        height: dp(40)
        orientation: 'horizontal'
        padding: dp(5)
        spacing: dp(4)
        canvas.before:
            Color:
                rgba: app.theme.row
            Rectangle:
                pos: self.pos
                size: self.size
        LocalFilePickerDirButton:
            id: dir_btn
            data_text: root.curr_dir_name
            size_hint_x: None
            width: dp(124)
            on_release:
                root.open_dir_dropdown(self)
        Label:
            size_hint_x: None
            width: dp(8)
        ButtonLabel:
            id: lb_path1
            text: root.curr_path_list[0] + ' ' if len(root.curr_path_list) > 0 else ''
            size_hint_x: None
            size: self.texture_size
            bold: True
            on_release:
                root.goto_path(0)
        ButtonLabel:
            id: lb_path2
            text: ' > ' + root.curr_path_list[1] + ' ' if len(root.curr_path_list) > 1 else ''
            size_hint_x: None
            size: self.texture_size
            bold: True
            on_release:
                root.goto_path(1)
        ButtonLabel:
            id: lb_path3
            text: ' > ' + root.curr_path_list[2] + ' ' if len(root.curr_path_list) > 2 else ''
            size_hint_x: None
            size: self.texture_size
            bold: True
            multiline: False
            on_release:
                root.goto_path(2)
        ButtonLabel:
            id: lb_path4
            text: ' > ' + root.curr_path_list[3] + ' ' if len(root.curr_path_list) > 3 else ''
            size_hint_x: None
            size: self.texture_size
            bold: True
            on_release:
                root.goto_path(3)
        ButtonLabel:
            id: lb_path5
            text: ' > ' + root.curr_path_list[4] + ' ' if len(root.curr_path_list) > 4 else ''
            size_hint_x: None
            size: self.texture_size
            bold: True
            on_release:
                root.goto_path(4)
        ButtonLabel:
            id: lb_path6
            text: ' > ' + root.curr_path_list[5] + ' ' if len(root.curr_path_list) > 5 else ''
            size_hint_x: None
            size: self.texture_size
            bold: True
            on_release:
                root.goto_path(5)
        Label:
            id: lb_path_placeholder
            size_hint_x: 1
    FileChooserListView:
        id: fc
        size_hint_y: 0.6
    Label:
        text: tr._('File name')
        size_hint_y: None
        height: dp(24) if root.show_filename else 0
        opacity: 1 if root.show_filename else 0
        disabled: not root.show_filename
        font_size: dp(15)
        halign: 'left'
        text_size: self.width, None
    TextInput:
        id: ti_filename
        multiline: False
        size_hint_y: None
        height: dp(36) if root.show_filename else 0
        opacity: 1 if root.show_filename else 0
        disabled: not root.show_filename
    BoxLayout:
        size_hint_y: None
        height: dp(44)
        spacing: dp(8)
        Button:
            id: btn_cancel
            text: tr._('Cancel')
        Button:
            id: btn_confirm
            text: tr._('Save')
