<DropDownSplitter>:
    size_hint_y: None
    height: '20dp'
    font_size: '13sp'
    text_size: self.size
    valign: 'middle'
    color: app.theme.text_muted
    canvas.before:
        Color:
            rgba: app.theme.row_strip
        Rectangle:
            pos: self.pos
            size: self.size
