#:import tr carveracontroller.__main__.tr

<-GCodePageBarButton>:
    icon: ''
    icon_size: 18
    text: ''
    size_hint_x: None
    width: dp(40)
    background_normal: ''
    background_down: ''
    background_disabled_normal: ''
    background_disabled_down: ''
    background_color: 0, 0, 0, 0
    color: 0, 0, 0, 0
    disabled_color: 0, 0, 0, 0
    border: 0, 0, 0, 0
    canvas:
        Color:
            rgba: (50/255, 164/255, 206/255, 0.28) if self.state == 'down' and not self.disabled else (0, 0, 0, 0)
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: (50/255, 164/255, 206/255, 1) if self.state == 'down' and not self.disabled else ((110/255, 110/255, 110/255, 1) if self.disabled else (1, 1, 1, 1))
        Rectangle:
            source: self.icon
            pos: self.center_x - dp(self.icon_size / 2), self.center_y - dp(self.icon_size / 2)
            size: dp(self.icon_size) if self.icon else 0, dp(self.icon_size) if self.icon else 0

<GCodePageBar>:
    page_label: '1 / 1'
    range_label: ''
    bar_visible: False
    orientation: 'horizontal'
    size_hint_y: None
    height: dp(40) if self.bar_visible else 0
    opacity: 1 if self.bar_visible else 0
    spacing: 0
    padding: 0
    canvas.before:
        Color:
            rgba: 80/255, 80/255, 80/255, 1
        Rectangle:
            pos: self.pos
            size: self.size
    GCodePageBarButton:
        icon: 'data/to_start.png'
        tooltip_txt: tr._('Jump to first page in file')
        disabled: root.backward_disabled
        on_release: root.go_first_page()
    GCodePageBarButton:
        icon: 'data/previous.png'
        icon_size: 16
        tooltip_txt: tr._('Go to previous page in file')
        disabled: root.backward_disabled
        on_release: root.go_previous_page()
    BoxLayout:
        orientation: 'vertical'
        size_hint_x: 1
        padding: dp(4), dp(4)
        Widget:
        Label:
            text: root.page_label
            size_hint_y: None
            height: dp(18)
            bold: True
            font_size: dp(15)
            color: 1, 1, 1, 1
            halign: 'center'
            valign: 'middle'
            text_size: self.size
        Label:
            text: root.range_label
            size_hint_y: None
            height: dp(14) if root.range_label else 0
            opacity: 1 if root.range_label else 0
            font_size: dp(12)
            color: 180/255, 180/255, 180/255, 1
            halign: 'center'
            valign: 'middle'
            text_size: self.size
            shorten: True
            shorten_from: 'right'
        Widget:
    GCodePageBarButton:
        icon: 'data/start.png'
        icon_size: 16
        tooltip_txt: tr._('Go to next page in file')
        disabled: root.forward_disabled
        on_release: root.go_next_page()
    GCodePageBarButton:
        icon: 'data/to_end.png'
        tooltip_txt: tr._('Jump to last page in file')
        disabled: root.forward_disabled
        on_release: root.go_last_page()
